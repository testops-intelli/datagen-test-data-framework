PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=datagen_demo
PG_USER=postgres
PG_PASSWORD=your_password

DEMO_SCHEMA=public
DEMO_TABLE=transactions

# How many passes of the base param space Mode 2 / Mode 3
# generate. Each pass resolves with the next distinct
# historical tuple (Mode 2) or candidate row (Mode 3).
# Automatically capped at however many are actually available.
MODE_2_MULTIPLIER=2
MODE_3_MULTIPLIER=2

# Where exported .xlsx files are written (relative to project root).
EXPORT_DIR=outputs
